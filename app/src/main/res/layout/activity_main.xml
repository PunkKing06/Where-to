<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hamburger menu: car avatar picker + nearest toilet -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/hamburgerButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_map_control_idle"
            android:backgroundTint="@null"
            android:padding="15dp"
            android:scaleType="center"
            android:src="@drawable/ic_menu"
            android:tint="#FF1F2937"
            android:contentDescription="Open menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Dedicated driving header: a large, glanceable maneuver card that
             turns the map into a navigation view rather than a plain map. -->
        <LinearLayout
            android:id="@+id/turnListPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="84dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:background="#F8FAFF"
            android:elevation="12dp"
            android:padding="18dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/turn1Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#172033"
                android:text="" />

            <TextView
                android:id="@+id/turn2Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textColor="#1A73E8"
                android:visibility="gone"
                android:text="" />

            <TextView
                android:id="@+id/turn3Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="15sp"
                android:textColor="#596273"
                android:visibility="gone"
                android:text="" />

        </LinearLayout>

        <!-- Recenter: appears once you've panned away from the follow camera -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/recenterButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_map_control"
            android:backgroundTint="@null"
            android:padding="2dp"
            android:scaleType="center"
            android:src="@drawable/ic_recenter"
            android:tint="#FFFFFFFF"
            android:contentDescription="Recenter map"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/muteButton"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/mediaControls"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="#EE0B0C0E"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView android:id="@+id/mediaArtwork" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_whereto_logo" android:scaleType="centerCrop" android:contentDescription="Album artwork" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:gravity="center_vertical" android:orientation="vertical">
                <TextView android:id="@+id/mediaTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Now playing" android:textColor="#FFFFFFFF" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/mediaArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFC7C7C7" android:textSize="12sp" android:maxLines="1" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/mediaPrevious" android:layout_width="42dp" android:layout_height="42dp" android:background="#00000000" android:padding="9dp" android:scaleType="center" android:src="@drawable/ic_media_previous" android:tint="#FFFFFFFF" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/mediaPlayPause" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_media_play" android:padding="11dp" android:scaleType="center" android:src="@drawable/ic_media_play" android:tint="#FFFFFFFF" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/mediaNext" android:layout_width="42dp" android:layout_height="42dp" android:background="#00000000" android:padding="9dp" android:scaleType="center" android:src="@drawable/ic_media_next" android:tint="#FFFFFFFF" />
        </LinearLayout>

        <!-- Mute: toggles spoken turn announcements -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/muteButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_map_control"
            android:backgroundTint="@null"
            android:padding="2dp"
            android:scaleType="center"
            android:src="@drawable/ic_volume_on"
            android:tint="#FFFFFFFF"
            android:contentDescription="Mute voice guidance"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/mediaControls"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Full setup panel, shown before a drive starts; hidden during one
             so the map can take over the screen, nav-app style. -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp"
            android:background="@drawable/bg_controls_panel"
            android:elevation="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navigateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:minHeight="52dp"
                android:text="Start a random drive"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="#1A73E8"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_random_drive"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

        </LinearLayout>

        <!-- Grounded stop control, separate from the route guidance card. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopDriveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            android:backgroundTint="#FFFFFF"
            android:textColor="#C5221F"
            android:text="End drive"
            app:layout_constraintBottom_toTopOf="@id/mediaControls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Slide-out drawer: pick your car avatar, jump to the nearest toilet -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:paddingTop="32dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Where to logo"
                android:src="@drawable/ic_whereto_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Where to?"
                android:textColor="#172033"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/enableMediaItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Enable music controls"
            android:textColor="#1A73E8"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Kept only for backwards-compatible avatar code; the driving UI
             now deliberately uses one clean navigation arrow. -->
        <LinearLayout
            android:id="@+id/carOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:background="#33000000" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Route preferences" android:textStyle="bold" android:textColor="#253047" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/avoidResidentialSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Avoid residential streets" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/avoidTollsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Avoid toll roads" />

        <TextView
            android:id="@+id/toiletMenuItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:drawableStart="@drawable/ic_restroom"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:text="Nearest toilet"
            android:textColor="#253047"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
